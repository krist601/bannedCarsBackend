meta {
  name: Complete cart
  type: http
  seq: 15
}

post {
  url: {{base_url}}/store/carts/{{cart_id}}/complete
  body: none
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

script:post-response {
  const d=res.body; const x=d.order||(d.type==='order'?d:null); if(x&&x.id) bru.setEnvVar('order_id',x.id);
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

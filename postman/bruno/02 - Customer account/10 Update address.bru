meta {
  name: Update address
  type: http
  seq: 10
}

post {
  url: {{base_url}}/store/customers/me/addresses/{{address_id}}?fields=*addresses
  body: json
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

body:json {
  {
    "address_name": "Postman Chile Updated",
    "city": "Santiago"
  }
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

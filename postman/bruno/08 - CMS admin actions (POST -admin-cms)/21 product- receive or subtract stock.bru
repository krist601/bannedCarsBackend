meta {
  name: product: receive or subtract stock
  type: http
  seq: 21
}

post {
  url: {{base_url}}/admin/cms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "action": "sealed_stock",
    "section": "{{section}}",
    "product_id": "{{product_id}}",
    "variant_id": "{{variant_id}}",
    "location_id": "{{location_id}}",
    "quantity": 1
  }
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

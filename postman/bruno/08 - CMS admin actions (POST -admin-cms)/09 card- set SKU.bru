meta {
  name: card: set SKU
  type: http
  seq: 9
}

post {
  url: {{base_url}}/admin/cms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "action": "card_sku",
    "printing_id": "{{printing_id}}",
    "sku": ""
  }
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

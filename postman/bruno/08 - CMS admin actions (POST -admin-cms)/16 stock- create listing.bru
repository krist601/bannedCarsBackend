meta {
  name: stock: create listing
  type: http
  seq: 16
}

post {
  url: {{base_url}}/admin/cms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "action": "listing",
    "printing_id": "{{printing_id}}",
    "condition": "near_mint",
    "finish": "non_foil",
    "language": "English",
    "sku": "EXAMPLE-SKU",
    "quantity": 1,
    "price_clp": 1000,
    "location_id": "{{location_id}}"
  }
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

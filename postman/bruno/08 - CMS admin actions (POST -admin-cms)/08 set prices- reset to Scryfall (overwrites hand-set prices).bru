meta {
  name: set prices: reset to Scryfall (overwrites hand-set prices)
  type: http
  seq: 8
}

post {
  url: {{base_url}}/admin/cms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "action": "set_prices_reset",
    "set_id": "{{set_id}}"
  }
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

meta {
  name: save storefront settings
  type: http
  seq: 1
}

post {
  url: {{base_url}}/admin/cms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "action": "storefront_settings",
    "settings": {
      "testCheckout": false
    }
  }
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

meta {
  name: Storefront settings (section switches, test checkout)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/store/storefront-settings
  body: none
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

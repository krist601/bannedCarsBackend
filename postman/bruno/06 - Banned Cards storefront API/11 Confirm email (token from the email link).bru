meta {
  name: Confirm email (token from the email link)
  type: http
  seq: 11
}

post {
  url: {{base_url}}/store/email-verification/confirm
  body: json
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

body:json {
  {
    "token": "{{verification_token}}"
  }
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

meta {
  name: List payment providers
  type: http
  seq: 21
}

get {
  url: {{base_url}}/store/payment-providers?region_id={{region_id}}
  body: none
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

script:post-response {
  const a=res.body.payment_providers||[]; if(a[0]) bru.setEnvVar('payment_provider_id',a[0].id);
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

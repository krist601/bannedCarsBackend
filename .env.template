POSTGRES_DB=banned_cards
POSTGRES_USER=banned_cards
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://banned_cards:replace-with-a-local-password@localhost:5433/banned_cards
REDIS_URL=redis://localhost:6380
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
JWT_SECRET=replace-with-a-long-random-value
COOKIE_SECRET=replace-with-a-different-long-random-value
WORKER_MODE=shared
DEV_ADMIN_EMAIL=replace-with-your-admin-email
DEV_ADMIN_PASSWORD=replace-with-a-strong-local-password

# Local S3-compatible card-image storage (MinIO).
MINIO_ROOT_USER=banned-cards-local
MINIO_ROOT_PASSWORD=replace-with-a-long-local-minio-password
FILE_STORAGE_DRIVER=s3
S3_FILE_URL=http://localhost:9002/banned-cards
S3_ACCESS_KEY_ID=banned-cards-local
S3_SECRET_ACCESS_KEY=replace-with-the-same-local-minio-password
S3_REGION=us-east-1
S3_BUCKET=banned-cards
S3_ENDPOINT=http://localhost:9002
S3_FORCE_PATH_STYLE=true
S3_PREFIX=catalog
SCRYFALL_USER_AGENT=BannedCards/0.1 (card-image-sync; contact: replace-with-contact)

# Add these only when beginning the Mercado Pago provider integration.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Optional Google customer sign-in (all three required; never expose secret in NEXT_PUBLIC variables)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Local HTTP loopback only; never enable on deployed servers.
LOCAL_HTTP_SESSION=false

# Account verification emails (Resend, https://resend.com). Leave RESEND_API_KEY empty in local development:
# messages are then only written to the server log.
RESEND_API_KEY=
# Sender shown to customers; its domain must be verified in Resend, e.g. "Banned Cards <hola@bannedcards.cl>"
EMAIL_FROM=
# Public storefront address used in the links inside emails (defaults to the first STORE_CORS origin)
STOREFRONT_URL=
# Local testing only: returns the verification link in the API response. NEVER set this on a deployed server.
EMAIL_DEV_MODE=

# Amazon SES (production): set EMAIL_DRIVER=ses and EMAIL_FROM="Banned Cards <compras@bannedcards.cl>".
# The AWS keys default to S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY (that IAM user may send from @bannedcards.cl only).
EMAIL_DRIVER=
SES_REGION=sa-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Address that receives a copy of every new order (delivery, RUT, boleta/factura). Defaults to compras@bannedcards.cl
STORE_ORDER_EMAIL=

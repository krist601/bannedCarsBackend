meta {
  name: stock: change price
  type: http
  seq: 15
}

post {
  url: {{base_url}}/admin/cms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "action": "price",
    "listing_id": "{{listing_id}}",
    "price_clp": 1000
  }
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

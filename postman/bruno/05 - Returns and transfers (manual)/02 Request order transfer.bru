meta {
  name: Request order transfer
  type: http
  seq: 2
}

post {
  url: {{base_url}}/store/orders/{{order_id}}/transfer/request
  body: json
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

body:json {
  {
    "description": "Postman transfer test",
    "update_order_email": false
  }
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

meta {
  name: Admin login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/user/emailpass
  body: json
  auth: none
}

body:json {
  {
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
  }
}

script:post-response {
  const d=res.body; if(d.token) bru.setEnvVar('admin_token',d.token);
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

meta {
  name: Accept order transfer
  type: http
  seq: 4
}

post {
  url: {{base_url}}/store/orders/{{order_id}}/transfer/accept
  body: json
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

body:json {
  {
    "token": "{{order_transfer_token}}"
  }
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

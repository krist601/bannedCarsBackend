meta {
  name: List return reasons
  type: http
  seq: 22
}

get {
  url: {{base_url}}/store/return-reasons?limit=100
  body: none
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

script:post-response {
  const a=res.body.return_reasons||[]; if(a[0]) bru.setEnvVar('return_reason_id',a[0].id);
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

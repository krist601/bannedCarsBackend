meta {
  name: List product tags
  type: http
  seq: 13
}

get {
  url: {{base_url}}/store/product-tags?limit=100
  body: none
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

script:post-response {
  const a=res.body.product_tags||[]; if(a[0]) bru.setEnvVar('product_tag_id',a[0].id);
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

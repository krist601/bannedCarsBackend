meta {
  name: stock listings
  type: http
  seq: 5
}

get {
  url: {{base_url}}/admin/cms?resource=stock&offset=0&location_id={{location_id}}&q=
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

script:post-response {
  const a=res.body.rows||[]; if(a[0]) bru.setEnvVar('listing_id',a[0].id);
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

meta {
  name: TCG sets directory
  type: http
  seq: 3
}

get {
  url: {{base_url}}/store/tcg/sets?limit=10&offset=0&q={{search_query}}
  body: none
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

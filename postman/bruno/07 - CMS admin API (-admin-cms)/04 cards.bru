meta {
  name: cards
  type: http
  seq: 4
}

get {
  url: {{base_url}}/admin/cms?resource=cards&offset=0&q={{search_query}}&set_id=
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

script:post-response {
  const a=res.body.rows||[]; if(a[0]) bru.setEnvVar('printing_id',a[0].id);
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

meta {
  name: List addresses
  type: http
  seq: 8
}

get {
  url: {{base_url}}/store/customers/me/addresses?limit=100
  body: none
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

script:post-response {
  const a=res.body.addresses||[]; if(a[0]) bru.setEnvVar('address_id',a[0].id);
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

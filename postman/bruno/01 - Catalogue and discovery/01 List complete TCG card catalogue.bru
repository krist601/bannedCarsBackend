meta {
  name: List complete TCG card catalogue
  type: http
  seq: 1
}

get {
  url: {{base_url}}/store/tcg/cards?limit=100&offset=0
  body: none
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

{
  "name": "banned-cards-server",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build && node ./scripts/link-admin-build.mjs",
    "start": "medusa start",
    "db:generate": "medusa db:generate tcgCatalog",
    "db:migrate": "medusa db:migrate",
    "catalog:import-set": "medusa exec ./src/scripts/import-scryfall-set.ts",
    "catalog:seed-demo-stock": "medusa exec ./src/scripts/seed-demo-card-inventory.ts",
    "images:sync": "medusa exec ./src/scripts/sync-card-images.ts",
    "images:dry-run": "medusa exec ./src/scripts/sync-card-images.ts dry-run",
    "postman:generate": "node ./scripts/generate-postman.mjs",
    "storage:configure": "node ./scripts/configure-local-storage.mjs",
    "storefront:configure": "medusa exec ./src/scripts/configure-storefront.ts",
    "infra:up": "docker compose up -d postgres redis minio minio-init",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres redis minio minio-init",
    "test": "node --test -r ts-node/register tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "sets:sync": "medusa exec ./src/scripts/sync-set-directory.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.0",
    "@medusajs/admin-shared": "2.21.0",
    "@medusajs/dashboard": "2.21.0",
    "@medusajs/draft-order": "2.21.0",
    "@medusajs/framework": "^2.20.1",
    "@medusajs/medusa": "^2.20.1"
  },
  "devDependencies": {
    "@medusajs/cli": "^2.20.1",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "7.3.6"
  }
}

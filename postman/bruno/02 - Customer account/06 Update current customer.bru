meta {
  name: Update current customer
  type: http
  seq: 6
}

post {
  url: {{base_url}}/store/customers/me?fields=*addresses
  body: json
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

body:json {
  {
    "first_name": "Postman",
    "last_name": "Banned Cards Tester"
  }
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

meta {
  name: Get variant
  type: http
  seq: 6
}

get {
  url: {{base_url}}/store/product-variants/{{variant_id}}?fields=*calculated_price,+inventory_quantity,+metadata
  body: none
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

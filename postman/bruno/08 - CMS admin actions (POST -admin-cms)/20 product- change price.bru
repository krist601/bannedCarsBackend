meta {
  name: product: change price
  type: http
  seq: 20
}

post {
  url: {{base_url}}/admin/cms
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "action": "sealed_price",
    "section": "{{section}}",
    "product_id": "{{product_id}}",
    "variant_id": "{{variant_id}}",
    "price_clp": 1000
  }
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

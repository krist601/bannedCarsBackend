meta {
  name: Hottest singles (last 30 days)
  type: http
  seq: 4
}

get {
  url: {{base_url}}/store/tcg/hottest
  body: none
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

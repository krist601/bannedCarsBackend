meta {
  name: List collections
  type: http
  seq: 9
}

get {
  url: {{base_url}}/store/collections?limit=100
  body: none
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

script:post-response {
  const a=res.body.collections||[]; if(a[0]) bru.setEnvVar('collection_id',a[0].id);
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

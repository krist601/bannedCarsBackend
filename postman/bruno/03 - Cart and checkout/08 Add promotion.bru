meta {
  name: Add promotion
  type: http
  seq: 8
}

post {
  url: {{base_url}}/store/carts/{{cart_id}}/promotions
  body: json
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

body:json {
  {
    "promo_codes": [
      "{{promotion_code}}"
    ]
  }
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

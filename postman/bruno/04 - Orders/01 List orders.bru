meta {
  name: List orders
  type: http
  seq: 1
}

get {
  url: {{base_url}}/store/orders?limit=100
  body: none
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

script:post-response {
  const a=res.body.orders||[]; if(a[0]){bru.setEnvVar('order_id',a[0].id); if(a[0].items&&a[0].items[0]) bru.setEnvVar('order_line_item_id',a[0].items[0].id);}
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

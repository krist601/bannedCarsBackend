meta {
  name: Create address
  type: http
  seq: 7
}

post {
  url: {{base_url}}/store/customers/me/addresses?fields=*addresses
  body: json
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

body:json {
  {
    "address_name": "Postman Chile",
    "first_name": "Postman",
    "last_name": "Tester",
    "address_1": "Av. Providencia 1234",
    "city": "Santiago",
    "province": "Region Metropolitana",
    "postal_code": "7500000",
    "country_code": "cl",
    "phone": "+56911111111",
    "is_default_shipping": true,
    "is_default_billing": true
  }
}

script:post-response {
  const a=(res.body.customer||{}).addresses||[]; if(a.length) bru.setEnvVar('address_id',a[a.length-1].id);
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

meta {
  name: Create cart
  type: http
  seq: 1
}

post {
  url: {{base_url}}/store/carts
  body: json
  auth: none
}

headers {
  x-publishable-api-key: {{publishable_key}}
}

body:json {
  {
    "region_id": "{{region_id}}",
    "email": "{{customer_email}}"
  }
}

script:post-response {
  const d=res.body.cart; if(d) bru.setEnvVar('cart_id',d.id);
}

tests {
  test("status is 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}
